 /* =========================================
           ABOUT PAGE
           ========================================= */

        .about-page {
            width: 100%;
            background: #ffffff;
            color: #333333;
            line-height: 1.7;
            font-family: Arial, Helvetica, sans-serif;
        }

        .about-container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 40px;
        }


        /* =========================================
           ABOUT INTRO
           ========================================= */

        .about-intro {
            position: relative;
            width: 100%;
            background: #7A1F2B;
            color: #ffffff;
            margin-bottom: 55px;
            overflow: hidden;
            text-align: center;
        }

        .about-intro-content {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 40px;
            position: relative;
            z-index: 1;
        }

        .about-intro::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 7px;
            height: 100%;
            background: #d8aeb5;
        }

        .about-intro::after {
            content: "";
            position: absolute;
            width: 200px;
            height: 200px;
            right: -80px;
            top: -80px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 50%;
        }

        .about-intro h1 {
            margin: 0 0 15px;
            color: #ffffff;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 44px;
            font-weight: normal;
            line-height: 1.2;
        }

        .about-intro p {
            max-width: 850px;
            margin: 0 auto;
            color: #f7e9eb;
            font-size: 16px;
            line-height: 1.8;
        }


        /* =========================================
           ABOUT SECTIONS
           ========================================= */

        .about-section {
            position: relative;
            margin-bottom: 55px;
            padding-bottom: 45px;
            border-bottom: 1px solid #eee8e9;
        }

        .about-section:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .about-section h2 {
            position: relative;
            margin: 0 0 18px;
            padding-left: 18px;
            color: #7A1F2B;
            font-size: 27px;
            font-weight: 700;
            line-height: 1.3;
        }

        .about-section h2::before {
            content: "";
            position: absolute;
            left: 0;
            top: 4px;
            width: 4px;
            height: 26px;
            background: #7A1F2B;
        }

        .about-section > p {
            max-width: 900px;
            margin: 0;
            color: #444444;
            font-size: 16px;
        }


        /* =========================================
           SCOPE
           ========================================= */

        .scope-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 28px;
        }

        .scope-card {
            position: relative;
            min-height: 100px;
            padding: 18px 20px;
            background: #faf9f9;
            border: 1px solid #e0d6d8;
            border-top: 4px solid #7A1F2B;
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                border-color 0.2s ease;
        }

        .scope-card:hover {
            transform: translateY(-4px);
            border-color: #b88991;
            box-shadow: 0 8px 20px rgba(70, 30, 35, 0.08);
        }

        .scope-number {
            display: block;
            margin-bottom: 8px;
            color: #b88991;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .scope-card h3 {
            margin: 0;
            color: #7A1F2B;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 21px;
            font-weight: normal;
            line-height: 1.4;
        }


        /* =========================================
           CONTRIBUTIONS
           ========================================= */

        .contribution-box {
            position: relative;
            padding: 28px 30px;
            background: #f8f3f4;
            border: 1px solid #e0d3d6;
            border-left: 5px solid #7A1F2B;
        }

        .contribution-box p {
            max-width: 850px;
            margin: 0;
            color: #444444;
            font-size: 16px;
        }


        /* =========================================
           AUTHOR RESPONSIBILITY
           ========================================= */

        .author-notice {
            position: relative;
            padding: 30px 32px;
            background: #ffffff;
            border: 1px solid #ded5d7;
            border-left: 5px solid #7A1F2B;
            box-shadow: 0 3px 12px rgba(60, 25, 30, 0.04);
        }

        .author-notice::before {
            content: "AUTHOR";
            display: block;
            margin-bottom: 12px;
            color: #7A1F2B;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .author-notice p {
            margin: 0;
            color: #444444;
            font-size: 15.5px;
        }


        /* =========================================
           COPYRIGHT
           ========================================= */

        .copyright-notice {
            position: relative;
            padding: 30px 32px;
            background: #f8f8f8;
            border: 1px solid #dddddd;
        }

        .copyright-notice::before {
            content: "COPYRIGHT";
            display: block;
            margin-bottom: 12px;
            color: #7A1F2B;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .copyright-notice p {
            margin: 0;
            color: #444444;
            font-size: 15.5px;
        }


        /* =========================================
           TABLET
           ========================================= */

        @media (max-width: 768px) {

            .about-container {
                padding: 45px 25px;
            }

            .about-intro-content {
                padding: 50px 30px;
            }

            .about-intro h1 {
                font-size: 36px;
            }

            .about-intro p {
                font-size: 15.5px;
            }

            .about-section {
                margin-bottom: 45px;
            }

            .about-section h2 {
                font-size: 24px;
            }

            .about-section > p {
                font-size: 15.5px;
            }

            .scope-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .scope-card {
                min-height: auto;
                padding: 18px 20px;
            }
        }


        /* =========================================
           MOBILE
           ========================================= */

        @media (max-width: 650px) {

            .about-container {
                padding: 35px 18px;
            }

            .about-intro-content {
                padding: 42px 22px;
            }

            .about-intro h1 {
                font-size: 31px;
            }

            .about-intro p {
                font-size: 14.5px;
                line-height: 1.7;
            }

            .about-section {
                margin-bottom: 40px;
            }

            .about-section h2 {
                margin-bottom: 13px;
                font-size: 22px;
            }

            .about-section h2::before {
                height: 22px;
            }

            .about-section > p {
                font-size: 15px;
            }

            .scope-grid {
                margin-top: 20px;
                gap: 14px;
            }

            .scope-card {
                padding: 17px 18px;
            }

            .scope-number {
                margin-bottom: 6px;
                font-size: 9px;
            }

            .scope-card h3 {
                font-size: 19px;
            }

            .contribution-box,
            .author-notice,
            .copyright-notice {
                padding: 24px 22px;
            }

            .author-notice p,
            .copyright-notice p,
            .contribution-box p {
                font-size: 14.5px;
            }
        }


        /* =========================================
           SMALL MOBILE
           ========================================= */

        @media (max-width: 320px) {

            .about-container {
                padding: 30px 15px;
            }

            .about-intro-content {
                padding: 35px 18px;
            }

            .about-intro h1 {
                font-size: 28px;
            }

            .about-section h2 {
                font-size: 21px;
            }

            .scope-card {
                padding: 16px;
            }

            .contribution-box,
            .author-notice,
            .copyright-notice {
                padding: 20px 18px;
            }
        }
