DirectoryIndex home.php index.php index.html

Options -MultiViews

# Custom 404 Error Page
ErrorDocument 404 /Convergence%20Project/custom404.php

RewriteEngine On

# Do not rewrite existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Admin login pretty URL
RewriteRule ^admin_login/?$ "Admin Panel/admin_login.php" [L]